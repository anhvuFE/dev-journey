# URL công khai của site (dùng cho metadata / OG image)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# (Tuỳ chọn) Khoá phân tích truy cập nếu sau này thêm analytics
# NEXT_PUBLIC_ANALYTICS_ID=""

# Endpoint Formspree cho form liên hệ ở trang About (tạo tại formspree.io)
NEXT_PUBLIC_FORMSPREE_ENDPOINT="https://formspree.io/f/xxxxxxxx"
